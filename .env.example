MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=portfolio-ap
# Optional server-only GitHub token to increase the repository API rate limit.
GITHUB_TOKEN=
# Optional: use only if your local resolver refuses Atlas SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Private /admin/analytics access. Never prefix these with NEXT_PUBLIC_.
ANALYTICS_ADMIN_USERNAME=
# Generate a random password (at least 24 characters); leave blank to disable access.
ANALYTICS_ADMIN_PASSWORD=
